# Copiar a .env y completar. NUNCA subir .env al repositorio.

# Proveedor de generación: extractive (sin LLM) | ollama | openai | groq | gemini
LLM_PROVIDER=extractive
# Vacío = modelo por defecto del proveedor (ver laboral_rag/llm.py)
LLM_MODEL=
LLM_API_KEY=
# Solo si se usa un endpoint distinto al predeterminado
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_MAX_CALLS=3

# Recuperación: bm25 | dense | hybrid
RETRIEVAL_MODE=hybrid
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=5
MIN_EVIDENCE_SCORE=0.15
